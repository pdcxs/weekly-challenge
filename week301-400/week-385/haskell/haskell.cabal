cabal-version:      3.0
name:               haskell
version:            0.1.0.0
build-type:         Simple

common warnings
    ghc-options: -Wno-x-partial -Wno-unrecognised-warning-flags

executable haskell
    import:           warnings
    main-is:          Main.hs
    other-modules:    Task1, Task2, Tests
    build-depends:    base,
                      HUnit,
                      containers
    hs-source-dirs:   src
    default-language: Haskell2010
